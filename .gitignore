# ============================================================
# CarePulse — .gitignore
# ============================================================

# --- Environments & Secrets (CRITICAL: Never commit .env) ---
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Database & Local State ---
*.sqlite3
db.sqlite3

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Operating System & Editor Artifacts ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.project
.settings/

# --- Antigravity IDE / Agent scratch ---
.system_generated/
scratch/
