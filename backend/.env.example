# ============================================================
# CarePulse — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Django Core ---
DJANGO_SECRET_KEY=change-me-super-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=carepulse.settings.local
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Supabase (Postgres + Storage) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=call-recordings

# --- CALL-E Voice Agent API ---
CALLE_API_KEY=your-calle-api-key
CALLE_API_BASE_URL=https://api.calle.ai/v1
CALLE_WEBHOOK_SECRET=your-calle-webhook-signing-secret
CALLE_AGENT_ID=your-calle-agent-id

# --- Clinical NLP (AMD Token Factory — Gemma) ---
GEMMA_API_KEY=your-amd-radeon-tokenfactory-api-key
GEMMA_API_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
GEMMA_MODEL=Gemma-4-31B-IT
AMD_API_KEY=your-amd-radeon-tokenfactory-api-key

# --- Scheduler ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
DAILY_CHECKIN_HOUR_UTC=14

# --- Admin Seed (superuser bootstrap) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@carepulse.health
ADMIN_SEED_PASSWORD=change-me-admin-password

# --- Frontend (Vite exposes only VITE_ prefixed vars) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws
